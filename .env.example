# Skopiuj do .env i wpisz własne, losowe wartości. Pliku .env nie commitujemy.
POSTGRES_PASSWORD=zmien-mnie
ConnectionStrings__Default=Host=localhost;Port=5433;Database=nautivo;Username=nautivo;Password=zmien-mnie
# Co najmniej 32 znaki. Bez poprawnego klucza logowanie administratora jest wyłączone.
# Ten sam klucz zapisz w przeglądarce: otwórz panel z adresem http://localhost:5173/#admin-key=<klucz>
Auth__AdminSecretKey=zmien-mnie-na-losowy-ciag-co-najmniej-32-znaki
